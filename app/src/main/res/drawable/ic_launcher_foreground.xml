<?xml version="1.0" encoding="utf-8"?>
<!-- A tap: a touch point with two ripples, and a short trail for "flow".
     Everything stays inside the 66dp safe zone of the 108dp adaptive icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer ripple -->
    <path
        android:pathData="M37,48a20,20 0,1 0,40 0a20,20 0,1 0,-40 0"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.4"
        android:fillColor="#00000000" />
    <!-- inner ripple -->
    <path
        android:pathData="M44,48a13,13 0,1 0,26 0a13,13 0,1 0,-26 0"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.75"
        android:fillColor="#00000000" />
    <!-- trail -->
    <path
        android:pathData="M38,77 Q46,66 57,48"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.85"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- touch point -->
    <path
        android:pathData="M50,48a7,7 0,1 0,14 0a7,7 0,1 0,-14 0"
        android:fillColor="#FFFFFF" />
</vector>
