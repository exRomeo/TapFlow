<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Images captured for image steps are pieces of the user's screen, so
     they never go into cloud backups or device-to-device transfers. Scripts do. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="templates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="templates/" />
    </device-transfer>
</data-extraction-rules>
